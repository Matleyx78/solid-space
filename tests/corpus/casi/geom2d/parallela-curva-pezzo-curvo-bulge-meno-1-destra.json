            "tolleranza": 3.552713678800501e-15
          }
        ],
        "fine": [
          {
            "valore": 0.5,
            "tolleranza": 3.552713678800501e-15
          },
          {
            "valore": 0,
            "tolleranza": 3.552713678800501e-15
          }
        ],
        "bulge": "-1"
      }
