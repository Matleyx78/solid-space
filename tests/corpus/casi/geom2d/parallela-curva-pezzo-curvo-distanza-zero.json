{
  "versione": 1,
  "id": "parallela-curva-pezzo-curvo-distanza-zero",
  "componente": "geom2d",
  "descrizione": "Curva parallela di un pezzo curvo a distanza zero: restituisce il pezzo stesso esatto.",
  "ingresso": {
    "operazione": "offsetCurve",
    "curva": {
      "pezzo": {
        "inizio": [
          1,
          0
        ],
        "fine": [
          -1,
          0
        ],
        "bulge": 1
      }
    },
    "distanza": 0
  },
  "atteso": {
    "esito": "done",
    "curva": {
      "pezzo": {
        "inizio": [
          "1",
          "0"
        ],
        "fine": [
          "-1",
          "0"
        ],
        "bulge": "1"
      }
    }
  },
  "provenienza": {
    "tipo": "aritmetica-esatta",
    "procedimento": "Regola del contratto: distanza zero dà il pezzo stesso esatto con estremi e bulge invariati."
  }
}
