        "angolo_iniziale": "0",
        "ampiezza": "3/2"
      }
    }
  },
  "provenienza": {
    "tipo": "aritmetica-esatta",
    "procedimento": "Arco antiorario con R=10 e d=-3 a destra (esterno). Nuovo raggio R - d = 10 - (-3) = 13. M=13, tolleranza raggio 13 * 2^-48 = 4.618527782440652e-14."
