{
  "versione": 1,
  "id": "boundary-retini-isole-annidate",
  "componente": "geom2d",
  "descrizione": "Richiesta #215, autocad-retini.dxf: il punto interno al rettangolo del retino ANSI31 (handle 109) restituisce il contorno, l'isola rettangolare e il cerchio annidato che AutoCAD ha salvato nei tre percorsi HATCH; il limite 10 dell'ADR 0014 non cambia i percorsi.",
  "ingresso": {
    "operazione": "detectBoundary",
    "punto": [
      5,
      -150
    ],
    "curve": [
      { "segmento": { "inizio": [60, -120], "fine": [0, -120] } },
      { "segmento": { "inizio": [0, -120], "fine": [0, -160] } },
      { "segmento": { "inizio": [0, -160], "fine": [60, -160] } },
      { "segmento": { "inizio": [60, -160], "fine": [60, -120] } },
      { "segmento": { "inizio": [10, -155], "fine": [10, -125] } },
      { "segmento": { "inizio": [10, -125], "fine": [50, -125] } },
      { "segmento": { "inizio": [50, -125], "fine": [50, -155] } },
      { "segmento": { "inizio": [50, -155], "fine": [10, -155] } },
      { "pezzo": { "inizio": [24, -140], "fine": [36, -140], "bulge": -1 } },
      { "pezzo": { "inizio": [36, -140], "fine": [24, -140], "bulge": -1 } }
    ],
    "unita_in_metri": 0.001
  },
  "atteso": {
    "esito": "enclosed",
    "loop": [
      {
        "loop": {
          "vertici": [
            ["0", "-160", "0"],
            ["60", "-160", "0"],
            ["60", "-120", "0"],
            ["0", "-120", "0"]
          ],
          "chiusa": true
        },
        "origini": [
          { "fonte": "curve", "curva": "2", "altra_curva": "2", "invertito": false },
          { "fonte": "curve", "curva": "3", "altra_curva": "3", "invertito": false },
          { "fonte": "curve", "curva": "0", "altra_curva": "0", "invertito": false },
          { "fonte": "curve", "curva": "1", "altra_curva": "1", "invertito": false }
        ],
        "profondita": "0"
      },
      {
        "loop": {
          "vertici": [
            ["10", "-155", "0"],
            ["50", "-155", "0"],
            ["50", "-125", "0"],
            ["10", "-125", "0"]
          ],
          "chiusa": true
        },
        "origini": [
