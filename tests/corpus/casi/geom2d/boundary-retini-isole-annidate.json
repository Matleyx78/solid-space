          "vertici": [
            ["24", "-140", "1"],
            ["36", "-140", "1"]
          ],
          "chiusa": true
        },
        "origini": [
          { "fonte": "curve", "curva": "9", "altra_curva": "9", "invertito": true },
          { "fonte": "curve", "curva": "8", "altra_curva": "8", "invertito": true }
        ],
        "profondita": "2"
      }
    ],
    "estremi_liberi": [],
